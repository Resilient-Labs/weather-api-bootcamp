document.querySelector('button').addEventListener('click',weather)


function weather(){
        const inputVal = document.querySelector('input').value.toLowerCase()
        const url =`https://api.openweathermap.org/data/2.5/weather?g={cityname},fcountry code}Sappid=19b1a629c55b8890a0b00f078ed1bc78&units=metric`
        console.log(inputVal)

        fetch(url)
        .then(res => res.json())
        .then ((data) =>{
        console.log(data)
        // console.log(inputVal)
        document.querySelector('h1').textContent = data.location.name
        document.querySelector('img').src = data.current.weather_icons
        document.querySelector('p').textContent =data.current.temperature
        document.querySelector('h3').textContent = data.current.weather_descriptions

    });


    }